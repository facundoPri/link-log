{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linklog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linklog",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{"binding":"CONTENT","bucket_name":"linklog-content"}],
  "queues": {
    "producers":[{"binding":"JOBS","queue":"linklog-jobs"},{"binding":"JEV_JOBS","queue":"linklog-jev"}],
    // Jev queue (ADR 0002): max_batch_size × max_concurrency is the ceiling on simultaneous Jev calls.
    // 2 × 4 = 8 keeps sustained load under TypeSafe's 100k input tokens/s (prod avg ~3.2k tokens, ~0.3 s per call); FAC-197 tunes it.
    "consumers":[{"queue":"linklog-jobs","max_batch_size":10,"max_batch_timeout":1,"max_retries":3,"max_concurrency":10},{"queue":"linklog-jev","max_batch_size":2,"max_batch_timeout":1,"max_retries":3,"max_concurrency":4}]
  },
  "workflows":[{"binding":"PROCESS_LINK","name":"linklog-process-link","class_name":"LinkWorkflow"}],
  "triggers":{"crons":["*/5 * * * *"]},
  "ai": {"binding":"AI","remote":true},
  "browser": {"binding":"BROWSER","remote":true},
  // Auth email (Cloudflare Email Service). Without `remote: true`, `wrangler dev` only simulates
  // sending and writes messages under .wrangler/tmp. Deploying needs Email Service enabled.
  "send_email": [{ "name": "EMAIL" }],
  // Fail closed: deployed Workers are "production" unless overridden. BETTER_AUTH_URL,
  // BETTER_AUTH_SECRET (secret) and EMAIL_FROM must be configured or the API answers 503.
  // scripts/dev.ts overrides APP_ENV/BETTER_AUTH_URL/BETTER_AUTH_SECRET for local runs.
  "vars": { "APP_ENV": "production" },
  // Auth links carry tokens in the query (verify, magic link) and path (reset). Invocation logs record
  // request URLs, so they stay off; console logs (sanitized auth events) remain.
  // Issues groups errors (needs Wrangler >= 4.134.0, and must stay here or a deploy turns it off).
  // Traces record spans per request, binding call, cron, queue and Workflow step.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "issues": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // Remaps stack traces in Issues, tail and logs. Wrangler < 4.150.0 only uploads maps when set.
  "upload_source_maps": true,
  // `wrangler deploy --env production` → https://linklog.facundopri.com. The top level stays local:
  // dev and tests never touch these resources. Secrets (wrangler secret put --env production):
  // BETTER_AUTH_SECRET, TYPESAFE_API_KEY.
  "env": {
    "production": {
      "name": "linklog",
      "routes": [{ "pattern": "linklog.facundopri.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "linklog-production",
          "database_id": "77281341-ff2d-4b76-a489-dbc3bd610008",
          "migrations_dir": "migrations",
        },
      ],
      "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "linklog-content-production" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "linklog-jobs-production" }, { "binding": "JEV_JOBS", "queue": "linklog-jev-production" }],
        "consumers": [
          { "queue": "linklog-jobs-production", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 10 },
          { "queue": "linklog-jev-production", "max_batch_size": 2, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 4 },
        ],
      },
      "workflows": [{ "binding": "PROCESS_LINK", "name": "linklog-process-link-production", "class_name": "LinkWorkflow" }],
      "triggers": { "crons": ["*/5 * * * *"] },
      "ai": { "binding": "AI" },
      "browser": { "binding": "BROWSER" },
      "send_email": [{ "name": "EMAIL" }],
      "vars": {
        "APP_ENV": "production",
        "BETTER_AUTH_URL": "https://linklog.facundopri.com",
        "EMAIL_FROM": "Linklog <auth@linklog.facundopri.com>",
        "JEV_PROVIDER": "typesafe",
      },
      "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true, "invocation_logs": false },
        "issues": { "enabled": true },
        "traces": { "enabled": true, "head_sampling_rate": 1 },
      },
    },
  },
}
