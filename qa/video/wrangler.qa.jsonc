// QA video harness Worker config: the product Worker behind qa/video/worker-entry.ts.
// No remote bindings (AI, Browser Rendering): the entry provides a fake BROWSER, so nothing paid can run.
// qa/video/env.ts copies this into qa/out/ with absolute paths and the run's overrides (vars below).
{
  "name": "linklog-qa-video",
  "main": "./worker-entry.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linklog",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "linklog-content" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "linklog-jobs" }],
    "consumers": [{ "queue": "linklog-jobs", "max_batch_size": 10, "max_batch_timeout": 1, "max_retries": 3, "max_concurrency": 10 }]
  },
  "workflows": [{ "binding": "PROCESS_LINK", "name": "linklog-process-link", "class_name": "LinkWorkflow" }],
  "vars": {
    "JEV_PROVIDER": "fixture",
    "ALLOW_FIXTURE_JEV": "1",
    "TYPESAFE_API_KEY": "",
    "BROWSER_CONCURRENCY": "2",
    "QA_FAST_RETRIES": "0",
    "QA_ALLOW_NET": "0"
  }
}
