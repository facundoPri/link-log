---
import Icon from "./Icon.astro";

const steps = [
  { icon: "plus", title: "Save", body: "Paste, drag or press ⌘K." },
  { icon: "pencil-simple-line", title: "Describe", body: "One sentence per tag." },
  { icon: "funnel-simple", title: "Find", body: "Filter, open or group." },
];
---

<section id="how" class="px-4 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mx-auto flex max-w-[680px] flex-col items-center gap-4 text-center" data-reveal>
      <p class="caption-3 rounded-full bg-brand-soft px-3 py-1 text-brand-strong">How it works</p>
      <h2 class="heading-4 md:heading-3 text-ink">Three steps, then it runs itself</h2>
    </div>

    <ol class="steps relative mt-16 grid gap-12 md:grid-cols-3 md:gap-6" data-steps>
      <span class="steps-line absolute left-[16.66%] right-[16.66%] top-6 hidden h-px origin-left bg-line-strong md:block" aria-hidden="true"></span>
      {
        steps.map((s, i) => (
          <li class="relative flex flex-col items-center gap-3 text-center" data-reveal style={`--reveal-delay:${i * 120}ms`}>
            <span class="step-icon relative flex size-12 items-center justify-center rounded-2xl bg-white text-ink shadow-[0_0_0_1px_var(--color-line),0_4px_12px_oklch(0.2_0.01_260/0.06)]">
              <Icon name={s.icon} weight="bold" class="size-5" />
              <span class="caption-3 tabular absolute -right-2 -top-2 flex size-6 items-center justify-center rounded-full bg-brand text-white">{i + 1}</span>
            </span>
            <h3 class="title-2 text-ink">{s.title}</h3>
            <p class="body-6 max-w-56 text-muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps-line { transform: scaleX(0); transition: transform 1200ms var(--ease-base) 200ms; }
  .steps.is-drawn .steps-line { transform: scaleX(1); }
  @media (prefers-reduced-motion: reduce) { .steps-line { transform: none; } }
</style>

<script>
  import { onceInView } from "../scripts/motion";
  const el = document.querySelector<HTMLElement>("[data-steps]");
  if (el) onceInView(el, () => el.classList.add("is-drawn"), 0.4);
</script>
