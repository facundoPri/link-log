---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";

// Each tag is a name plus a sentence the model reads. That sentence is the user's criterion.
const tags = [
  { name: "recipes", tone: 1, rule: "Any page with a recipe: ingredients and steps." },
  { name: "quick dinner", tone: 7, rule: "Recipes I can cook on a weeknight: under 30 minutes of active work, one pan or pot." },
  { name: "research", tone: 5, rule: "Papers, essays and long technical explainers I want to cite later." },
  { name: "to read", tone: 2, rule: "Long reads worth a quiet hour. Not news, not product pages." },
  { name: "side project", tone: 3, rule: "Docs and tools that help me build Linklog: Cloudflare, Chrome extensions, React." },
];

const samples = [
  {
    title: "One pan lemon orzo with spinach",
    domain: "seriouseats.com",
    letter: "S",
    tone: 2,
    words: "1,284 words",
    scores: { recipes: 97, "quick dinner": 88, research: 3, "to read": 12, "side project": 1 },
  },
  {
    title: "Red wine short ribs, braised for four hours",
    domain: "bonappetit.com",
    letter: "B",
    tone: 0,
    words: "2,067 words",
    scores: { recipes: 98, "quick dinner": 9, research: 2, "to read": 21, "side project": 1 },
  },
  {
    title: "Local first software: you own your data",
    domain: "inkandswitch.com",
    letter: "I",
    tone: 5,
    words: "11,932 words",
    scores: { recipes: 0, "quick dinner": 0, research: 93, "to read": 86, "side project": 67 },
  },
];
---

<section id="autotags" class="bg-surface px-4 py-24 md:py-24">
  <div class="mx-auto max-w-6xl">
    <SectionHeader
      eyebrow="Auto tags"
      icon="sparkle"
      title="Tags that follow your rules"
      lede="Give each tag a sentence describing what belongs in it. Linklog reads the whole page, scores every tag in one call and applies only the ones that clear your threshold."
    />

    <div class="mt-12 grid gap-6 lg:grid-cols-[1fr_1.15fr]" data-autotags data-samples={JSON.stringify(samples)}>
      <!-- Tag rules -->
      <div class="flex flex-col gap-4" data-reveal>
        <div class="flex items-center justify-between">
          <p class="title-4 text-ink">Your tags</p>
          <p class="caption-5 text-muted">Written once, used on every link</p>
        </div>
        <ul class="flex flex-col gap-2">
          {
            tags.map((t) => (
              <li class={`rule-card t${t.tone} flex gap-3 rounded-xl bg-white p-3 shadow-[0_0_0_1px_var(--color-line)]`} data-rule={t.name}>
                <span class="mt-1 dot" />
                <div class="min-w-0 flex-1">
                  <div class="flex items-center gap-2">
                    <span class="title-4 text-ink">{t.name}</span>
                    <span class="rule-state caption-4 ml-auto flex items-center gap-1 text-brand" data-rule-state>
                      <Icon name="check" weight="bold" class="size-3" /> Applied
                    </span>
                  </div>
                  <p class="body-6 mt-1 text-muted">{t.rule}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Evaluation -->
      <div class="window flex flex-col self-start" data-reveal style="--reveal-delay:120ms">
        <div class="flex gap-1 bg-surface p-2 shadow-[inset_0_-1px_0_var(--color-line)]" role="tablist" aria-label="Sample links">
          {
            samples.map((s, i) => (
              <button
                type="button"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-sample={i}
                class="sample-tab caption-4 flex min-w-0 flex-1 items-center gap-2 rounded-lg px-2 py-2 text-left text-muted transition-colors duration-300 ease-base hover:text-ink"
              >
                <span class={`favicon t${s.tone}`}>{s.letter}</span>
                <span class="truncate">{s.domain}</span>
              </button>
            ))
          }
        </div>

        <div class="flex flex-col gap-6 p-4 sm:p-6">
          <div class="flex items-start gap-3">
            <span class="favicon t2 mt-0.5" data-s-favicon>S</span>
            <div class="min-w-0">
              <p class="title-3 text-ink" data-s-title>{samples[0]!.title}</p>
              <p class="caption-5 mt-0.5 flex flex-wrap items-center gap-2 text-muted">
                <span data-s-domain>{samples[0]!.domain}</span>
                <span aria-hidden="true">·</span>
                <span class="flex items-center gap-1"><Icon name="article" class="size-3" /><span data-s-words>{samples[0]!.words}</span> read</span>
              </p>
            </div>
          </div>

          <div>
            <div class="flex items-center justify-between">
              <p class="caption-3 text-faint">Confidence</p>
              <p class="caption-4 flex items-center gap-1 text-brand" data-eval-status aria-live="polite">
                <span class="pulse-dot size-1.5 rounded-full bg-brand"></span> Scoring 5 tags in one call
              </p>
            </div>
            <ul class="mt-3 flex flex-col gap-3">
              {
                tags.map((t) => (
                  <li class={`score-row t${t.tone} grid grid-cols-[96px_1fr_40px] items-center gap-3`} data-score-row={t.name}>
                    <span class="caption-4 truncate text-ink-2">{t.name}</span>
                    <span class="relative h-2 rounded-full bg-subtle">
                      <span class="score-fill absolute inset-0 origin-left rounded-full" data-fill />
                      <span class="threshold-track pointer-events-none absolute inset-y-0 left-0 w-full" data-threshold-track>
                        <span class="absolute -top-1 -bottom-1 left-0 w-0.5 -translate-x-px rounded-full bg-ink/40" />
                      </span>
                    </span>
                    <span class="caption-4 tabular text-right text-muted" data-pct>0%</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="rounded-xl bg-surface p-3 shadow-[inset_0_0_0_1px_var(--color-line)]">
            <div class="flex items-center justify-between gap-4">
              <label for="threshold" class="caption-4 text-ink-2">Threshold</label>
              <span class="caption-3 tabular text-ink" data-threshold-label>80%</span>
            </div>
            <input id="threshold" type="range" min="40" max="95" step="1" value="80" class="threshold-range mt-2 w-full" data-threshold />
            <p class="caption-5 mt-2 text-muted">Each tag keeps its own threshold. 80% is where it starts.</p>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <p class="caption-3 text-faint">Applied</p>
              <div class="mt-2 flex min-h-5 flex-wrap gap-1" data-applied></div>
            </div>
            <div>
              <p class="caption-3 text-faint">Kept as scores only</p>
              <div class="mt-2 flex min-h-5 flex-wrap gap-1" data-discarded></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<template id="chip-template">
  <span class="chip pop pop-enter"><span class="dot"></span><span data-name></span><span class="tabular opacity-60" data-chip-pct></span></span>
</template>

<style>
  .sample-tab[aria-selected="true"] {
    background: white;
    color: var(--color-ink);
    box-shadow: 0 0 0 1px var(--color-line), 0 1px 2px oklch(0.2 0.01 260 / 0.06);
  }
  .score-fill {
    background: var(--color-line-strong);
    transform: scaleX(0);
    transition: transform 900ms var(--ease-base), background-color 300ms var(--ease-base);
  }
  .score-row.is-pass .score-fill { background: var(--tag-dot); }
  .score-row.is-pass [data-pct] { color: var(--color-ink); font-weight: 600; }
  .threshold-track { transform: translateX(80%); transition: transform 300ms var(--ease-base); }
  .rule-card { transition: box-shadow 300ms var(--ease-base), opacity 300ms var(--ease-base); }
  .rule-card.is-pass { box-shadow: 0 0 0 1px var(--tag-dot), 0 4px 12px oklch(0.2 0.01 260 / 0.06); }
  .rule-state { opacity: 0; transform: translateX(-4px); transition: opacity 300ms var(--ease-base), transform 500ms var(--ease-base); }
  .rule-card.is-pass .rule-state { opacity: 1; transform: none; }
  [data-eval-status] { transition: opacity 300ms var(--ease-base); }
  .chip.is-discarded { background: var(--color-subtle); color: var(--color-muted); }
  .chip.is-discarded .dot { background: var(--color-faint); }

  .threshold-range { appearance: none; height: 20px; background: transparent; }
  .threshold-range::-webkit-slider-runnable-track { height: 4px; border-radius: 9999px; background: var(--color-line); }
  .threshold-range::-moz-range-track { height: 4px; border-radius: 9999px; background: var(--color-line); }
  .threshold-range::-webkit-slider-thumb {
    appearance: none; width: 16px; height: 16px; margin-top: -6px; border-radius: 9999px;
    background: white; box-shadow: 0 0 0 1px var(--color-line-strong), 0 1px 3px oklch(0.2 0.01 260 / 0.2);
    transition: transform 300ms var(--ease-base);
  }
  .threshold-range::-moz-range-thumb {
    width: 16px; height: 16px; border: 0; border-radius: 9999px;
    background: white; box-shadow: 0 0 0 1px var(--color-line-strong), 0 1px 3px oklch(0.2 0.01 260 / 0.2);
  }
  .threshold-range:hover::-webkit-slider-thumb { transform: scale(1.12); }
  .threshold-range:active::-webkit-slider-thumb { transform: scale(0.98); }
</style>

<script>
  import { initAutoTags } from "../scripts/autotags";
  initAutoTags();
</script>
