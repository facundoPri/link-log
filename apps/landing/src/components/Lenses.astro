---
import Icon from "./Icon.astro";
import SectionHeader from "./SectionHeader.astro";

const lenses = [
  {
    id: "week",
    question: "Worth reading this week?",
    kind: "yesno",
    options: ["Yes", "Unsure", "No"],
  },
  {
    id: "project",
    question: "Which project is this for?",
    kind: "choice",
    options: ["Linklog", "Thesis", "Kitchen", "Other"],
  },
  {
    id: "time",
    question: "How long will it take?",
    kind: "choice",
    options: ["Under 10 min", "Under an hour", "Longer"],
  },
];

// answers[lensId] = [option, confidence]
const links = [
  { title: "Local first software: you own your data", domain: "inkandswitch.com", letter: "I", tone: 5,
    answers: { week: ["Yes", 91], project: ["Linklog", 78], time: ["Longer", 84] } },
  { title: "Attention is all you need", domain: "arxiv.org", letter: "A", tone: 0,
    answers: { week: ["Unsure", 52], project: ["Thesis", 92], time: ["Longer", 95] } },
  { title: "Designing calm interfaces for dense data", domain: "uxdesign.cc", letter: "U", tone: 6,
    answers: { week: ["Yes", 83], project: ["Linklog", 64], time: ["Under an hour", 71] } },
  { title: "Weeknight dal with crispy shallots", domain: "bonappetit.com", letter: "B", tone: 1,
    answers: { week: ["No", 6], project: ["Kitchen", 97], time: ["Under an hour", 66] } },
  { title: "Fourteen product launches this week", domain: "producthunt.com", letter: "P", tone: 7,
    answers: { week: ["No", 11], project: ["Other", 71], time: ["Under 10 min", 88] } },
  { title: "D1 prepared statements and batching", domain: "developers.cloudflare.com", letter: "C", tone: 2,
    answers: { week: ["Unsure", 58], project: ["Linklog", 95], time: ["Under 10 min", 62] } },
  { title: "How diffusion models learn to denoise", domain: "youtube.com", letter: "Y", tone: 0,
    answers: { week: ["Yes", 87], project: ["Thesis", 81], time: ["Under an hour", 77] } },
];
---

<section id="lenses" class="px-4 py-24">
  <div class="mx-auto max-w-6xl">
    <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto]">
      <SectionHeader
        eyebrow="Lenses"
        icon="aperture"
        title="Ask a question, get an answer for every link"
        lede="A lens is one question asked of every link you select or every tab you have open. Answers come back as yes or no with a confidence, or as one of your own options. Your tags stay as they are."
      />
      <ul class="caption-5 flex flex-col gap-2 text-muted lg:pb-2" data-reveal>
        <li class="flex items-center gap-2"><Icon name="check" weight="bold" class="size-4 text-brand" /> Yes, no or a choice with an Other option</li>
        <li class="flex items-center gap-2"><Icon name="check" weight="bold" class="size-4 text-brand" /> Results saved per link</li>
        <li class="flex items-center gap-2"><Icon name="check" weight="bold" class="size-4 text-brand" /> Filter by answer, then act on the matches</li>
      </ul>
    </div>

    <div class="window mt-12" data-lenses data-lens-data={JSON.stringify({ lenses, links })} data-reveal style="--reveal-delay:120ms">
      <div class="flex flex-col gap-3 bg-surface p-3 shadow-[inset_0_-1px_0_var(--color-line)] sm:p-4">
        <div class="flex flex-wrap gap-2" role="radiogroup" aria-label="Lens">
          {
            lenses.map((l, i) => (
              <button
                type="button"
                role="radio"
                aria-checked={i === 0 ? "true" : "false"}
                data-lens={l.id}
                class="lens-pill caption-4 flex items-center gap-2 rounded-lg bg-white px-3 py-2 text-ink-2 shadow-[0_0_0_1px_var(--color-line)] transition-[transform,box-shadow,color] duration-300 ease-base hover:-translate-y-px active:scale-[0.98]"
              >
                <Icon name="aperture" class="size-4" />
                {l.question}
                <span class="caption-5 text-faint">{l.kind === "yesno" ? "Yes or no" : "Choice"}</span>
              </button>
            ))
          }
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <Icon name="funnel-simple" class="size-4 text-muted" />
          <div class="flex flex-wrap gap-1" data-filters aria-label="Filter by answer"></div>
          <span class="caption-4 ml-auto flex items-center gap-2 text-muted" data-lens-status aria-live="polite"></span>
        </div>
      </div>

      <ul class="flex flex-col p-2" data-lens-rows>
        {
          links.map((l, i) => (
            <li class="lens-row flex items-center gap-3 rounded-lg px-2 py-2" data-lens-row={i}>
              <span class={`favicon t${l.tone}`}>{l.letter}</span>
              <div class="min-w-0 flex-1">
                <span class="body-5 block truncate text-ink">{l.title}</span>
                <span class="caption-5 block truncate text-muted">{l.domain}</span>
              </div>
              <span class="flex shrink-0 justify-end sm:w-40" data-verdict />
            </li>
          ))
        }
      </ul>
      <p class="caption-5 flex items-center gap-2 p-4 text-muted shadow-[inset_0_1px_0_var(--color-line)]">
        <Icon name="tag" class="size-4" />
        Lenses never change tags. Turn one off and its filter goes with it; the answers stay saved.
      </p>
    </div>
  </div>
</section>

<style>
  .lens-pill[aria-checked="true"] {
    color: var(--color-ink);
    box-shadow: 0 0 0 1.5px var(--color-ink), 0 2px 6px oklch(0.2 0.01 260 / 0.08);
  }
  .lens-row { transition: opacity 300ms var(--ease-base); }
  .lens-row.is-leaving { opacity: 0; }
  .verdict { transition: opacity 500ms var(--ease-base), transform 500ms var(--ease-base); }
  .verdict.is-new { opacity: 0; transform: translateX(8px); }
</style>

<script>
  import { initLenses } from "../scripts/lenses";
  initLenses();
</script>
