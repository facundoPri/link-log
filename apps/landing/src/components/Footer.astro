---
import Logo from "./Logo.astro";
import { APP_URL, REPO_URL, RELEASES_URL, NAV } from "../data/site";
const isHome = Astro.url.pathname === "/";
const year = new Date().getFullYear();
---

<footer class="bg-surface px-4 py-16 shadow-[inset_0_1px_0_var(--color-line)]">
  <div class="mx-auto flex max-w-6xl flex-col gap-12 md:flex-row md:justify-between">
    <div class="flex max-w-xs flex-col gap-4">
      <a href="/" class="self-start rounded-md" aria-label="Linklog home"><Logo /></a>
      <p class="body-6 text-muted">A personal library for links and open tabs, organized by rules you write.</p>
    </div>
    <div class="grid grid-cols-2 gap-12 sm:grid-cols-3">
      <div>
        <p class="caption-3 text-faint">Product</p>
        <ul class="mt-4 flex flex-col gap-2">
          {NAV.map((n) => (
            <li><a class="body-6 rounded-sm text-ink-2 transition-colors duration-300 ease-base hover:text-ink" href={isHome ? n.href : `/${n.href}`}>{n.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="caption-3 text-faint">Get started</p>
        <ul class="mt-4 flex flex-col gap-2">
          <li><a class="body-6 rounded-sm text-ink-2 transition-colors duration-300 ease-base hover:text-ink" href={APP_URL}>Open the app</a></li>
          <li><a class="body-6 rounded-sm text-ink-2 transition-colors duration-300 ease-base hover:text-ink" href={RELEASES_URL}>Chrome extension</a></li>
        </ul>
      </div>
      <div>
        <p class="caption-3 text-faint">Project</p>
        <ul class="mt-4 flex flex-col gap-2">
          <li><a class="body-6 rounded-sm text-ink-2 transition-colors duration-300 ease-base hover:text-ink" href={REPO_URL}>Source on GitHub</a></li>
          <li><a class="body-6 rounded-sm text-ink-2 transition-colors duration-300 ease-base hover:text-ink" href={`${REPO_URL}/issues`}>Report an issue</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="caption-5 mx-auto mt-12 flex max-w-6xl flex-col gap-2 text-faint sm:flex-row sm:justify-between">
    <p>© {year} Linklog</p>
    <p>Made with Astro. Runs on Cloudflare.</p>
  </div>
</footer>
