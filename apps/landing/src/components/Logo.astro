---
import Icon from "./Icon.astro";
interface Props { class?: string }
const { class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <span class="flex size-6 items-center justify-center rounded-md bg-brand text-white">
    <Icon name="link-simple" weight="bold" class="size-4" />
  </span>
  <span class="title-3 tracking-tight text-ink">Linklog</span>
</span>
