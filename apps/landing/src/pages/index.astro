---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Sources from "../components/Sources.astro";
import Bento from "../components/Bento.astro";
import Showcase from "../components/Showcase.astro";
import Tagline from "../components/Tagline.astro";
import Steps from "../components/Steps.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import { FAQ } from "../data/faq";
import { REPO_URL } from "../data/site";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Linklog",
    applicationCategory: "ProductivityApplication",
    operatingSystem: "Web, Chrome",
    description:
      "A private library for links and open tabs. Linklog reads each page, auto tags it with rules you write and answers questions about it with lenses.",
    url: Astro.site?.toString(),
    sameAs: [REPO_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: FAQ.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<Base
  title="Linklog: links and tabs, sorted the way you think"
  description="Save links and open tabs in one private library. Linklog reads each page, auto tags it with rules you write and answers your questions with lenses."
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <Sources />
  <Bento />
  <Showcase />
  <Tagline />
  <Steps />
  <Faq />
  <FinalCta />
</Base>
